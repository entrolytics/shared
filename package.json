{
  "name": "@entrolytics/shared",
  "version": "2.4.2",
  "description": "Shared utilities for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "constants",
    "entrolytics",
    "types"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:check": "vp lint . && vp fmt --check .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "vp fmt --write .",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
