{
  "name": "@entrolytics/shared",
  "version": "3.1.0",
  "description": "Shared utilities for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "constants",
    "entrolytics",
    "types"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.17.0"
}
